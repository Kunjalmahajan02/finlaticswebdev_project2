# Supabase → Project Settings → Database → Connection string
# Pooled connection (port 6543), used by the app at runtime
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432), used by Prisma to create tables
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# https://console.groq.com/keys
GROQ_API_KEY=""
# Optional: override the default model (openai/gpt-oss-120b)
GROQ_MODEL=""

# NextAuth: URL of the site, and a random secret (run: npx auth secret, or openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# GitHub → Settings → Developer settings → OAuth Apps
GITHUB_ID=""
GITHUB_SECRET=""
